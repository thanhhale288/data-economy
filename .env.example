DATABASE_URL=postgresql://mfg_economy:mfg_economy_pass@localhost:5432/mfg_economy
REDIS_URL=redis://localhost:6379/0
VITE_API_URL=http://localhost:8000

# Optional ops-only marketplace session cookies (ADR-0002). Never commit real values.
# SHOPEE_SESSION_COOKIE=
# TIKTOK_SESSION_COOKIE=

# Marketplace shop discovery (Task #36/#43) — OFF unless explicitly enabled.
# MARKETPLACE_DISCOVERY_ENABLED=0
# MARKETPLACE_DISCOVERY_THRESHOLD=0.65
# Candidates: data/mappings/discovery_allowlist.json (entries: [] by default).
# Live brand→shop search exists in code but is often anti-bot blocked; see docs/ops-demo.md.

# Optional narrative LLM (OpenAI-compatible). Keys never logged. Missing key → rules fallback.
# BENCHMARK_NARRATIVE_LLM_KEY=
# FORECAST_NARRATIVE_LLM_KEY=
# OPENAI_API_KEY=
# BENCHMARK_NARRATIVE_LLM_MODEL=gpt-4o-mini
# FORECAST_NARRATIVE_LLM_MODEL=gpt-4o-mini
# Per-service BASE_URL wins over NARRATIVE_LLM_BASE_URL; host/base is joined with /chat/completions.
# BENCHMARK_NARRATIVE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FORECAST_NARRATIVE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# NARRATIVE_LLM_BASE_URL=https://api.openai.com/v1
